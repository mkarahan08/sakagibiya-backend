# Sunucu portu (varsayılan: 5000)
PORT=5000

# MongoDB bağlantı URI
MONGODB_URI=mongodb://localhost:27017

# JWT imza için gizli anahtar (güçlü ve rastgele olmalı)
JWT_SECRET=fef2aacea28ea632ce51caa60ead17cbc23f69f5c9b7dbcb5d3f666638b4d35c

# Frontend URL (CORS whitelist için, örn. Vercel deploy URL)
FRONTEND_URL=https://your-frontend.vercel.app

# Production için
# NODE_ENV=production

# --- Şifre Sıfırlama (Forgot Password) Yapılandırması ---

# Resend API anahtarı (https://resend.com/api-keys)
RESEND_API_KEY=re_xxx

# Şifre sıfırlama e-postalarının gönderildiği adres
# Geliştirmede: onboarding@resend.dev (Resend'in default sandbox adresi)
# Production'da: kendi domain'inizde doğrulanmış adres (örn. noreply@sakagibiya.com)
RESEND_FROM_EMAIL=onboarding@resend.dev

# Reset token (kısa ömürlü JWT) imzalama için ana JWT_SECRET'tan AYRI gizli anahtar
RESET_JWT_SECRET=change-me-to-a-strong-random-256bit-secret

# 6 haneli sıfırlama kodunun geçerlilik süresi (dakika)
PASSWORD_RESET_CODE_TTL_MINUTES=10

# Doğrulama sonrası üretilen reset token'ın geçerlilik süresi (dakika)
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# Bir kod kaydı için izin verilen maksimum yanlış deneme sayısı
PASSWORD_RESET_MAX_ATTEMPTS=3

# E-posta gönderim transport'u: "resend" (gerçek SDK) veya "mock" (bellek-içi kuyruk - test/dev)
EMAIL_TRANSPORT=resend
